# 环境变量（包含 API Key 和密码）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# 数据库文件
*.db
*.db-shm
*.db-wal

# 知识库种子数据：随仓库分发（同事 clone 后可直接使用；本机运行库写入的 WAL/变化不入库）
!backend/data/enterprise_rag.db

# ChromaDB 向量数据
chroma_data/

# 缓存
cache/
*.pkl

# Node
node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 上传文件（开发环境）
backend/uploads/

# 数据迁移备份
backend/backup_*/

# 评测结果输出
backend/eval/results/

# Claude Code 检查结果
.claude/check-results/*.json

# Electron 构建产物（源项目遗留）
release/

# 爬虫运行时落盘数据（原始 HTML / Markdown / 临时批量文件，可重新爬取）
backend/crawler/data/*
!backend/crawler/data/db/
backend/crawler/data/db/*
# 爬虫库随仓库分发（站点配置/采集记录，供爬取中心页面展示）
!backend/crawler/data/db/crawler.db

# 本地调试输出
vite_err.txt
vite_out.txt
