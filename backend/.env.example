# ============================================================
# 人工智能学院教学知识库 - 环境配置
# 复制此文件为 .env 并修改配置项
# ============================================================

# --- 应用基础配置 ---
APP_NAME=人工智能学院教学知识库
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# --- 服务端口 ---
HOST=0.0.0.0
PORT=8001

# --- 数据库 ---
# SQLite 默认（无需修改）
DATABASE_URL=sqlite:///./data/enterprise_rag.db

# --- 阿里云百炼（DashScope）---
# 必填！从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your-api-key-here
# 若使用本项目百炼工作空间的 Key，需同时填写工作空间端点（与线上一致）：
# DASHSCOPE_BASE_URL=https://<工作空间>.cn-beijing.maas.aliyuncs.com/api/v1
# DASHSCOPE_OPENAI_BASE_URL=https://<工作空间>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 使用个人百炼账号的标准 Key 时留空即可，走官方默认端点
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# qwen3 系思考模式；线上为 false（降低首字延迟），保持与线上一致
LLM_ENABLE_THINKING=false
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# --- 检索配置 ---
# 向量后端：auto=按 SQLite 版本自动选择；faiss=固定 FAISS（交付的索引为 FAISS 格式，
# 在 SQLite>=3.35 的机器上 auto 会改选 ChromaDB 导致检索为空，生产部署务必固定 faiss）
VECTOR_BACKEND=faiss
VECTOR_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=50
RERANK_CANDIDATES=10
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5
QUERY_REWRITE_MODE=conditional

# --- 分块配置 ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- 生产安全自检 ---
# 启动时检测占位 JWT 密钥/弱管理员口令/关闭验证码，命中即拒绝启动（与 DEBUG 无关）。
# 仓库示例保持 false；仅在本地临时调试时改为 true（部署脚本会强制写回 false）。
SKIP_SAFETY_CHECK=false

# --- JWT 认证 ---
# 生产部署务必改为随机长字符串！保留默认值会导致 Token 可被伪造
JWT_SECRET_KEY=jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- 登录验证码 ---
# 线上为 true；本地自动化测试可临时改为 false
CAPTCHA_ENABLED=true

# --- AI 助手 ---
# 是否启用悬浮 AI 助手入口（复用主教学知识库 RAG，无独立知识库配置）
COUNSELOR_ENABLED=true

# --- 接口限流 ---
# 进程内令牌桶（问答 / AI 助手 / TTS 各自计数）；多进程部署需改用共享存储
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- 缓存 ---
CACHE_TTL_ANSWER=86400
CACHE_TTL_SESSION=3600

# --- 默认管理员 ---
# 仅在数据库中不存在该账号时生效；交付数据包内已内置 admin 账号（初始密码见交付包内《00-交付必读》）
# 生产部署务必改为强密码；保留该占位值会被启动安全自检拒绝
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@company.com
