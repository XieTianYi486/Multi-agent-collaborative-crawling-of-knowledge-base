# ============================================================
# 人工智能学院教学知识库 - 环境配置
# 复制此文件为 .env 并修改配置项
# ============================================================

# --- 应用基础配置 ---
APP_NAME=人工智能学院教学知识库
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# --- 服务端口 ---
HOST=0.0.0.0
PORT=8001

# --- 数据库 ---
# SQLite 默认（无需修改）
DATABASE_URL=sqlite:///./data/enterprise_rag.db

# --- 阿里云百炼（DashScope）---
# 必填！从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# --- 检索配置 ---
VECTOR_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=50
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5

# --- 分块配置 ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- JWT 认证 ---
# 生产部署务必改为随机长字符串！保留默认值会导致 Token 可被伪造
JWT_SECRET_KEY=jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI 导员知识库 ---
# full=整库条款全量注入（小知识库推荐，无漏召回、免调阈值）
# retrieval=向量+BM25 混合检索 top-k + 余弦阈值判定
COUNSELOR_CONTEXT_MODE=full
# 全量注入上下文长度告警阈值（条文总量超出后建议切回 retrieval）
COUNSELOR_MAX_CONTEXT_CHARS=80000
COUNSELOR_TOP_K=6
COUNSELOR_MIN_SCORE=0.3

# --- 缓存 ---
CACHE_TTL_ANSWER=86400
CACHE_TTL_SESSION=3600

# --- 默认管理员 ---
# 生产部署务必改密码！启动时若仍为默认值会打印安全告警
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@company.com
